# Base URL of the Laravel API, reached via nginx (docker-compose "nginx" service, :8000).
# Physical device (Expo Go) on the same Wi-Fi: use this machine's LAN IP.
# Android emulator: use http://10.0.2.2:8000/api (maps to host localhost).
# iOS simulator: http://localhost:8000/api works directly.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.3:8000/api
