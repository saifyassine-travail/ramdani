# Shared `mediassist` Postgres DB (read-only) — same values as Backend/MediAssist/.env
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=mediassist
DB_USERNAME=postgres
DB_PASSWORD=root

# Local Ollama server, reached from inside Docker.
OLLAMA_HOST=http://host.docker.internal:11434
# Default: the general-purpose draft model (see ../../summary-lab). Once
# summary-lab/scripts/export_to_ollama.sh has produced a real fine-tune,
# switch this to SUMMARY_MODEL=mediassist-summary and restart this service.
SUMMARY_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_S=120

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
