# ─── WhatsApp sending: Open-WA (self-hosted, unofficial) ───────────────────
# UNOFFICIAL: this drives a real WhatsApp Web session (openwa.dev), not
# Meta's Cloud API. Violates WhatsApp's Terms of Service — the linked
# number can be banned. Chosen deliberately anyway (no business
# verification, no template approval, free). Assumes an already-running,
# already-linked Open-WA instance (a separate project — see ~/OpenWA on
# this machine, or https://openwa.dev/docs/getting-started for a fresh
# setup: run it, scan the QR code with the clinic's WhatsApp once, done).
#
# OPENWA_URL: reach it via the docker network it's on (see docker-compose.yml
# — this service joins openwa-network) rather than the host, since the
# instance's published port is typically bound to 127.0.0.1 only.
# OPENWA_API_KEY: the X-API-Key issued by that instance.
# OPENWA_SESSION_ID: the session's UUID (not its name) — list sessions with
#   curl -H "X-API-Key: $OPENWA_API_KEY" http://127.0.0.1:2785/api/sessions
OPENWA_URL=http://openwa-api:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# ─── Patient phone number normalization ────────────────────────────────────
# patients.phone_num has no stored format (usually local, e.g. 0612345678).
# This is prepended when a number has no country code / leading +.
DEFAULT_COUNTRY_CODE=212

# ─── Shared `mediassist` Postgres DB (read-only) ───────────────────────────
# Same values as Backend/MediAssist/.env — this service only reads
# appointments/patients/user_settings, never writes.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=mediassist
DB_USERNAME=postgres
DB_PASSWORD=root

# Clinic's own wall-clock timezone — "whatsapp_reminder_hour" in Settings
# (e.g. 11) means 11:00 in THIS timezone, not the Laravel app's UTC.
CLINIC_TIMEZONE=Africa/Casablanca

# How often the background poller checks whether it's time to send
# (SentReminder dedup makes more-frequent polling harmless).
WHATSAPP_REMINDER_POLL_MINUTES=15

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
