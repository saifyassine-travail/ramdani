# ─── CIN OCR engine ─────────────────────────────────────────────────────────
# "ollama" (default, more accurate, needs Ollama running with a vision model
# pulled) or "tesseract" (no extra runtime, less accurate on real cards).
OCR_ENGINE=ollama

# Local Ollama server (https://ollama.com) — never leaves the machine, no API
# key. Use http://127.0.0.1:11434 when running this service directly on the
# host; use http://host.docker.internal:11434 when this service runs in
# Docker and Ollama runs natively on the host (the default docker-compose
# setup for this project).
OLLAMA_HOST=http://host.docker.internal:11434
# Any Ollama vision model works; qwen2.5vl:3b is a good size/accuracy balance
# for a 4GB-class GPU. A larger tag (e.g. qwen2.5vl:latest / 8.3B) is more
# accurate but noticeably slower without a GPU that fits it, run:
#   ollama pull qwen2.5vl:3b
OLLAMA_MODEL=qwen2.5vl:3b
# Keep the model resident in memory between scans (Ollama's own default is
# "5m") — avoids a slow cold-reload for every scan after an idle gap.
OLLAMA_KEEP_ALIVE=30m
# Generous enough to cover a cold model load (well over a minute on CPU for
# an 8B-class model) plus inference — a ceiling, not typical per-scan latency
# (~20s once the model is warm).
OLLAMA_TIMEOUT_S=300

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
