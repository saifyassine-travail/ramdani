# ─── WhatsApp sending: Meta Cloud API (official) ───────────────────────────
# Replaced the earlier Open-WA gateway (unofficial WhatsApp Web automation),
# which was free and could send freeform text but violated WhatsApp's Terms
# of Service — the clinic's number could be banned with no appeal.
#
# WHATSAPP_TOKEN: a *System User* token, not a Graph Explorer one. Generate
#   it at business.facebook.com -> Business Settings -> System users ->
#   (your system user) -> Generate token, app "MediAssist", expiration
#   "Never", scopes whatsapp_business_messaging + whatsapp_business_management.
#   A Graph Explorer token looks identical but expires within the hour.
# WHATSAPP_PHONE_NUMBER_ID: the numeric ID of the sending number, NOT the
#   number itself. WhatsApp Manager -> API Setup, or:
#   curl -G "https://graph.facebook.com/v21.0/<WABA_ID>/phone_numbers" \
#        -H "Authorization: Bearer $WHATSAPP_TOKEN"
# WHATSAPP_TEMPLATE_NAME / _LANG: the approved template supplying the French
#   wording. It must be APPROVED on the WABA before a single reminder can go
#   out — a PENDING one is refused at send time with error 132001. It takes
#   two positional variables: {{1}} first name, {{2}} appointment date.
#
# The service safely no-ops (logs only) until the first two are set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=rappel_rendez_vous
WHATSAPP_TEMPLATE_LANG=fr


# ─── Patient phone number normalization ────────────────────────────────────
# patients.phone_num has no stored format (usually local, e.g. 0612345678).
# This is prepended when a number has no country code / leading +.
DEFAULT_COUNTRY_CODE=212

# ─── Shared `mediassist` Postgres DB (read-only) ───────────────────────────
# Same values as Backend/MediAssist/.env — this service only reads
# appointments/patients/user_settings, never writes.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=mediassist
DB_USERNAME=postgres
DB_PASSWORD=root

# Clinic's own wall-clock timezone — "whatsapp_reminder_hour" in Settings
# (e.g. 11) means 11:00 in THIS timezone, not the Laravel app's UTC.
CLINIC_TIMEZONE=Africa/Casablanca

# How often the background poller checks whether it's time to send
# (SentReminder dedup makes more-frequent polling harmless).
WHATSAPP_REMINDER_POLL_MINUTES=15

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
